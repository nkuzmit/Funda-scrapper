[Unit]
Description=Funda Scraper Bot
# Start once the network is up, not merely once networking has started: at boot
# the startup scrape and the drain of old Telegram commands need it (review C16).
Wants=network-online.target
After=network-online.target

# Paths must match the live server. This VPS has no `ubuntu` user — the bot runs as
# root from /home/Funda-scrapper. Confirm before installing:
#   systemctl show funda-bot -p WorkingDirectory -p User
[Service]
Type=simple
User=root
WorkingDirectory=/home/Funda-scrapper
ExecStart=/home/Funda-scrapper/venv/bin/python main.py
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
